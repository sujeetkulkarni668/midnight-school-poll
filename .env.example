# Midnight network to hint to the wallet on connect (undeployed | testnet | mainnet)
VITE_MIDNIGHT_NETWORK_ID=undeployed

# Midnight services. Leave unset to run the app in local simulation mode.
VITE_NODE_URI=http://127.0.0.1:9944
VITE_INDEXER_URI=http://127.0.0.1:8088/api/v1/graphql
VITE_INDEXER_WS_URI=ws://127.0.0.1:8088/api/v1/graphql/ws
VITE_PROOF_SERVER_URI=http://127.0.0.1:6300

# Address printed by `npm run contract:deploy`
VITE_POLL_CONTRACT_ADDRESS=
