# Midnight On-Chain Network Configuration
# Set these in your Vercel Dashboard -> Settings -> Environment Variables

# Network ID (default: testnet-02)
VITE_MIDNIGHT_NETWORK_ID="testnet-02"

# Deployed Midnight Poll Contract Address (Hex or Bech32 format)
VITE_POLL_CONTRACT_ADDRESS=""

# Midnight Testnet Service Endpoints
VITE_INDEXER_URI="https://indexer.testnet-02.midnight.network/api/v1/graphql"
VITE_INDEXER_WS_URI="wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws"
VITE_NODE_URI="https://rpc.testnet-02.midnight.network"
VITE_PROOF_SERVER_URI="https://proof-server.testnet-02.midnight.network"
